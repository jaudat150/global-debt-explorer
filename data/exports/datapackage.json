{
  "name": "global-debt-fiscal-atlas",
  "title": "Global Debt & Fiscal Atlas — open data export",
  "description": "Sovereign debt, deficits, government spending, revenue, macro and development indicators for every country, plus bilateral who-owes-whom debt, with full provenance.",
  "version": "3.4.0",
  "created": "2026-11-03T11:18:59+00:00",
  "homepage": "https://github.com/Jaudat150/global-debt-explorer",
  "licenses": [
    {
      "name": "CC-BY-4.0",
      "title": "Data: see each provider's terms (World Bank CC BY 4.0, IMF terms, SIPRI, WHO, UNESCO)"
    }
  ],
  "sources": [
    {
      "title": "World Bank Indicators API",
      "path": "https://api.worldbank.org/v2/"
    },
    {
      "title": "IMF DataMapper API",
      "path": "https://www.imf.org/external/datamapper/api/"
    }
  ],
  "contributors": [
    {
      "title": "Jaudat Faisal Al-Husein",
      "role": "author"
    }
  ],
  "resources": [
    {
      "name": "countries",
      "path": "countries.csv",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "description": "Country reference: ISO codes, names and map coordinates.",
      "rows": 250,
      "schema": {
        "fields": [
          {
            "name": "iso3",
            "type": "string",
            "description": "ISO 3166-1 alpha-3 country code (XKX = Kosovo)"
          },
          {
            "name": "iso2",
            "type": "string",
            "description": "ISO 3166-1 alpha-2 country code"
          },
          {
            "name": "name",
            "type": "string",
            "description": "Country name"
          },
          {
            "name": "latitude",
            "type": "number",
            "description": "Label point latitude (Natural Earth)"
          },
          {
            "name": "longitude",
            "type": "number",
            "description": "Label point longitude (Natural Earth)"
          }
        ]
      }
    },
